# Same-origin UI/API needs no CORS exception. Add exact origins only if required.
CORS_ORIGINS=

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Docker token
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token

# Per-file upload limit: 15 MiB
MAX_UPLOAD_BYTES=15728640

# Batch input and generated archive limits: 512 MiB each
MAX_BATCH_UPLOAD_BYTES=536870912
MAX_BATCH_ARCHIVE_BYTES=536870912
MAX_BATCH_FILES=500

# Memory safeguards
UPLOAD_CHUNK_BYTES=65536
MAX_DECODED_SAMPLES=24000000
